---
source: crates/rattler_conda_version/src/version/parse.rs
expression: index_map
---
{
    "$": Error(
        "expected a version component e.g. `2` or `rc`",
    ),
    ".": Error(
        "expected a version component e.g. `2` or `rc`",
    ),
    "1!1.2a.3-rc1": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1!1.2a.3_rc1": Version(
        Version {
            version: [[1], [1], [2, 'a'], [3], [0, 'rc', 1]],
            local: [],
        },
    ),
    "1+": Error(
        "expected a version component e.g. `2` or `rc`",
    ),
    "1+$": Error(
        "expected a version component e.g. `2` or `rc`",
    ),
    "1+.": Error(
        "expected a version component e.g. `2` or `rc`",
    ),
    "1+2": Version(
        Version {
            version: [[0], [1]],
            local: [[2]],
        },
    ),
    "1--": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1-2-3": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1-2-3_": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1-2_3": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1-_": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1.0.1-": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1.0.1_": Version(
        Version {
            version: [[0], [1], [0], [1, '_']],
            local: [],
        },
    ),
    "1.0.1post.za": Version(
        Version {
            version: [[0], [1], [0], [1, inf], [0, 'za']],
            local: [],
        },
    ),
    "1@2": Error(
        "encountered more characters but expected none",
    ),
    "1_": Version(
        Version {
            version: [[0], [1, '_']],
            local: [],
        },
    ),
    "1_-": Error(
        "'-' is not allowed in versions because package filenames use it to separate the name, version, and build string; use '_' or '.' instead",
    ),
    "1_2_3": Version(
        Version {
            version: [[0], [1], [2], [3]],
            local: [],
        },
    ),
    "1_2_3_": Version(
        Version {
            version: [[0], [1], [2], [3, '_']],
            local: [],
        },
    ),
    "1__": Version(
        Version {
            version: [[0], [1], [0, '_']],
            local: [],
        },
    ),
    "1___": Error(
        "encountered more characters but expected none",
    ),
}
